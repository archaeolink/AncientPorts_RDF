@prefix ns1: <http://purl.org/vocommons/voaf#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.ancientports.com/ont#> a ns1:Vocabulary,
        owl:Ontology ;
    rdfs:label "http://www.ancientports.com/ont# Vocabulary"@en ;
    vann:preferredNamespacePrefix "ont"^^xsd:anyURI ;
    vann:preferredNamespaceUri "http://www.ancientports.com/ont#"^^xsd:anyURI ;
    ns1:usageInDataset "http://data.archaeology.link/data/ancientports/"^^xsd:anyURI .

